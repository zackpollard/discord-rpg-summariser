# Copy to .env next to docker-compose.prod.yml before deploying.
# Compose loads .env for every subcommand, so `down`, `logs` and `ps` keep
# working without exporting these in your shell.

# Required. Alphanumeric: it is interpolated into a postgres:// URL, so
# @ : / ? # % would have to be percent-encoded.
POSTGRES_PASSWORD=changeme

# Discord OAuth2 for the web panel. Leave both blank to run the panel
# unauthenticated behind your own authenticating reverse proxy.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Set to true to silence the startup warning when running the panel without
# Discord OAuth2.
WEB_ALLOW_UNAUTHENTICATED=
